# Clicky-Store local development environment
# Copy this file to .env before running Docker Compose:
#
#   cp .env.example .env
#   docker compose up --build
#
# Do not commit your real .env file.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_ENV=development

# Port inside the server container.
PORT=8080

# Port exposed on your host machine.
HOST_PORT=8080

# Allowed frontend origin used by the Go CORS middleware.
# For the embedded frontend served by the API, localhost:8080 is enough.
FRONTEND_ORIGIN=http://localhost:8080

# Change this for serious testing.
# In production, this must be long, random, and private.
AUTH_SECRET=change-me-for-local-development

# -----------------------------------------------------------------------------
# Seeded admin account
# -----------------------------------------------------------------------------
# The current code still seeds hardcoded admin credentials in cmd/server/main.go.
# These variables are prepared for the planned auth/admin-seeding refactor.

ADMIN_NAME=Clicky Admin
ADMIN_EMAIL=admin@clicky.local
ADMIN_PASSWORD=admin12345

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# PostgreSQL is already started by Compose, but the current server still uses
# the in-memory store until the PostgreSQL adapter is implemented and wired in.

POSTGRES_VERSION=16-alpine
POSTGRES_DB=clicky_store
POSTGRES_USER=clicky
POSTGRES_PASSWORD=clicky_dev_password
POSTGRES_HOST_PORT=5432
POSTGRES_DATA_PATH=./data/postgresql

# Connection string prepared for the future PostgreSQL store adapter.
DATABASE_URL=postgres://clicky:clicky_dev_password@db:5432/clicky_store?sslmode=disable

# -----------------------------------------------------------------------------
# Container names
# -----------------------------------------------------------------------------

SERVER_CONTAINER_NAME=clicky-server
DB_CONTAINER_NAME=clicky-db

# -----------------------------------------------------------------------------
# Health checks
# -----------------------------------------------------------------------------

SERVER_HEALTHCHECK_INTERVAL=10s
SERVER_HEALTHCHECK_TIMEOUT=3s
SERVER_HEALTHCHECK_RETRIES=5
SERVER_HEALTHCHECK_START_PERIOD=10s

POSTGRES_HEALTHCHECK_INTERVAL=10s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=5
POSTGRES_HEALTHCHECK_START_PERIOD=10s
